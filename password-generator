function randomPassword(){
    let length = parseInt(prompt("Introduce longitud de la contraseña: "));
    if(length < 0 || isNaN(length) || length > 15){
        return ("El número "+length+ " no está permitido.")
    }
    const characters = "1234567890abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%&/()=?¿{}-_*+";
    let exitPassword = [];    
        for(let i = 0; i < length; i++){
            let random = Math.floor(Math.random()*characters.length);
            exitPassword.push(characters[random]);   
    }
    console.log(exitPassword.join(""));
}
randomPassword();
